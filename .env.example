# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional local defaults for /dev/simulator.
# Do not commit real production tokens here.
NEXT_PUBLIC_SIMULATOR_DEVICE_ID=SIMULATOR-COLAGEM
NEXT_PUBLIC_SIMULATOR_DEVICE_TOKEN=dev-simulator-token
NEXT_PUBLIC_SIMULATOR_INPUT_GPIO=1

# ESP32 default identity used by firmware examples.
ESP32_DEVICE_ID=esp32-colagem-prototipo-01
ESP32_DEVICE_TOKEN=TOKEN_SECRETO_DO_DISPOSITIVO

# Local API base used by examples and firmware configuration notes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
